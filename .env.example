# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/mcq_db
NEON_CONNECTION_STRING=postgresql://user:password@neon.tech/mcq_db

# Security
SECRET_KEY=your-secret-key-change-in-production
SESSION_COOKIE_SECURE=True
ENABLE_HTTPS=True

# College Information
COLLEGE_NAME=Vidya Vikas Institute of Engineering and Technology, Solapur
ACADEMIC_YEAR=2024-2025

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# Features
ENABLE_TAB_SWITCH_WARNING=True
ENABLE_IP_LOGGING=True
DISABLE_COPY_PASTE=True
SINGLE_DEVICE_LOGIN=True

# Debug
DEBUG_MODE=False
